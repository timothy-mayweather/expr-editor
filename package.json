{
  "name": "@timothy-mayweather/expr-editor",
  "version": "1.0.0",
  "description": "A WebAssembly-powered real-time linter and autocomplete code editor for antonmedv/expr",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timothy-mayweather/expr-editor.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "generate:parser": "lezer-generator src/lib/expr.grammar -o src/lib/expr.js",
    "check": "svelte-check --tsconfig",
    "prepackage": "npm run generate:parser",
    "package": "svelte-package",
    "test": "vitest run",
    "prepublishOnly": "npm run package"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/wasm_exec.js",
    "**/wasm_exec.js"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./expr_linter_manifest": {
      "default": "./dist/expr_linter.manifest.js"
    }
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6",
    "@codemirror/language": "^6",
    "@codemirror/lint": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "svelte": "^5.0.0",
    "svelte-codemirror-editor": "^2.1.0"
  },
  "dependencies": {
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.0",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^24",
    "@vitest/browser-playwright": "^4.1.8",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "publint": "^0.3.21",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "^2.1.1"
  },
  "keywords": [
    "svelte",
    "expr",
    "codemirror",
    "editor",
    "wasm",
    "golang"
  ]
}